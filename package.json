{
	"name": "fabric-inbox",
	"private": true,
	"license": "AGPL-3.0-only OR LicenseRef-PassionCode-Commercial",
	"homepage": "https://github.com/passioncode-ai/fabric-inbox",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/passioncode-ai/fabric-inbox.git"
	},
	"type": "module",
	"cloudflare": {
		"label": "Fabric Inbox",
		"products": [
			"Workers",
			"Durable Objects",
			"R2",
			"Workers AI"
		],
		"bindings": {
			"DOMAINS": {
				"description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
			}
		}
	},
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types --strict-vars=false",
		"deploy": "npm run build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "npm run build && vite preview",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"test": "node --import tsx --test tests/*.test.ts",
		"desktop": "electron desktop",
		"desktop:package": "node desktop/package.mjs",
		"desktop:mas": "node desktop/mas-package.mjs",
		"desktop:dmg": "node desktop/dist-mac.mjs",
		"desktop:server-bundle": "npm run build && node scripts/server-bundle.mjs",
		"mcp:docs": "node --import tsx scripts/mcp-docs.ts"
	},
	"dependencies": {
		"@cloudflare/ai-chat": "^0.1.8",
		"@cloudflare/kumo": "^1.13.0",
		"@modelcontextprotocol/sdk": "^1.26.0",
