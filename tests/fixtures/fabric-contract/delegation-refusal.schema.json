{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/delegation-refusal.schema.json",
  "title": "A refusal under the contract's one code set (DEC-0039)",
  "description": "What a callee, the hub or the meter answers when it refuses: error.code from the one set, a sentence in error.message, and product detail in error.data. An MCP tool returns it as structuredContent of a result with isError true; an HTTP route as the JSON body.",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "data": {
          "type": "object",
          "properties": {
            "detail": { "type": "string", "minLength": 1, "maxLength": 80 },
            "window": { "enum": ["total", "task", "project", "day", "week", "month", "call"], "description": "The window reached with limit-reached. DEC-0041: call is a grant's perCallMaxUsd exceeded, a refusal window rather than a grant limit window, at level L3." },
            "level": { "enum": ["L0", "L1", "L2", "L3"] },
            "actionDigest": { "$ref": "common.schema.json#/$defs/sha256" },
            "approvalRequest": { "$ref": "common.schema.json#/$defs/uri" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "code": { "const": "limit-reached" } }, "required": ["code"] },
          "then": { "required": ["data"], "properties": { "data": { "type": "object", "required": ["window"], "properties": { "window": true } } } }
        },
        {
          "if": { "properties": { "data": { "type": "object", "required": ["window"], "properties": { "window": { "const": "call" } } } }, "required": ["data"] },
          "then": { "properties": { "data": { "type": "object", "required": ["level"], "properties": { "level": { "const": "L3" } } } } }
        },
        {
          "if": { "properties": { "code": { "const": "approval-required" } }, "required": ["code"] },
          "then": { "required": ["data"], "properties": { "data": { "type": "object", "required": ["actionDigest"], "properties": { "actionDigest": true } } } }
        },
        {
          "if": { "properties": { "code": { "const": "human-step-required" } }, "required": ["code"] },
          "then": { "required": ["data"], "properties": { "data": { "type": "object", "required": ["humanStep", "url"], "properties": { "humanStep": { "enum": ["sign-in", "consent", "payment", "secret", "spend-above-limit", "passkey"], "description": "The person's step (DEC-0121 AP-4)." }, "url": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(https://|/)", "description": "The direct link to that step: an https URL or a path on the service's origin (DEC-0121 AP-4)." } } } } }
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "code": {
      "enum": [
        "unauthenticated",
        "token-expired",
        "wrong-audience",
        "scope-not-granted",
        "effect-above-ceiling",
        "no-grant",
        "grant-expired",
        "grant-revoked",
        "limit-reached",
        "approval-required",
        "approval-invalid",
        "approval-reused",
        "principal-unproven",
        "credential-source-refused",
        "chain-too-deep",
        "profile-forbids",
        "issuer-unavailable",
        "unknown-state",
        "operator-decision-required",
        "decision-invalid",
        "human-step-required"
      ]
    }
  }
}
